# Bu dosyayı .env olarak kopyalama. Sadece referans.
# Vercel'de: Project → Settings → Environment Variables

# OpenAI anahtarı (platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# YA DA OpenRouter anahtarı (openrouter.ai/keys) — daha ucuz
# OPENROUTER_API_KEY=sk-or-...

# İsteğe bağlı model
# MODEL=gpt-4o-mini
